          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> Chuyển StringT IO-Link (không có ký tự kết thúc) thành STRING, cắt ở 64 ký tự</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">sTmp := '';
IF pBuf &lt;&gt; 0 THEN
    n := MIN(uiLen, 64);
    pDst := ADR(sTmp);
    i := 0;
    WHILE i &lt; n DO
        IF pBuf[i] = 0 THEN          // device có thể đệm 0 ở cuối
            EXIT;
        END_IF
        pDst[i] := pBuf[i];
        i := i + 1;
    END_WHILE
    pDst[i] := 0;
END_IF
F_IolBytesToStr := sTmp;
</xhtml>
          </ST>
        </body>
